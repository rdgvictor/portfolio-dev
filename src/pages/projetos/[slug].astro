---
import Base from '../../layouts/Base.astro';
import Imagem from '../../components/Imagem.astro';
import Calculadora from '../../components/Calculadora.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const todos = (await getCollection('projetos')).sort((a, b) => a.data.ordem - b.data.ordem);
  return todos.map((p, i) => ({ params: { slug: p.slug }, props: { p, proximo: todos[(i + 1) % todos.length] } }));
}
const { p, proximo } = Astro.props;
const d = p.data;
const { Content } = await p.render();
---
<Base titulo={d.nome} descricao={`${d.nome} · ${d.tipo}`}>
  <div class="prod">
    <Imagem src={d.imagem} rotulo={`captura de tela principal · ${d.nome}`} />
    <div class="txt">
      <a class="back" href="/projetos/">← todos os projetos</a>
      <span class="eyebrow">{d.origem}</span>
      <h1>{d.nome}</h1>
      <div class="lead"><Content /></div>
      <dl class="info">
        {d.ficha.map((f) => <div><dt>{f.rotulo}</dt><dd>{f.valor}</dd></div>)}
        <div><dt>status</dt><dd>{d.status}</dd></div>
      </dl>
      {d.link && <a class="btn" href={d.link} target="_blank" rel="noopener">{d.textoLink || 'Abrir'}</a>}
    </div>
  </div>
  {d.calculadora && <Calculadora />}
  {d.galeria.length > 0 && (
    <div class="more">
      <h2>Informações adicionais</h2>
      <div class="duo">
        {d.galeria.map((g, i) => (
          <figure>
            <Imagem src={g.imagem} rotulo={`captura de tela ${i + 1} · ${d.nome}`} />
            {g.legenda && <figcaption>{g.legenda}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  )}
  <p class="next"><a class="back" href={`/projetos/${proximo.slug}/`}>próximo projeto: {proximo.data.nome} →</a></p>
</Base>
