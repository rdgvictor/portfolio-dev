---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import contato from '../data/contato.json';
const curto = (u: string) => u.replace(/^https?:\/\/(www\.)?[^/]+/, '');
---
<Base titulo="Contato">
  <div class="contact">
    <div>
      <h1>{contato.titulo}</h1>
      <p>{contato.texto}</p>
    </div>
    <div class="clinks">
      <button type="button" id="copy" data-email={site.email}><span>e-mail</span><span>{site.email}</span><span id="copy-l">copiar</span></button>
      <a href={site.linkedin} target="_blank" rel="noopener"><span>LinkedIn</span><span>{curto(site.linkedin)}</span><span>abrir</span></a>
      <a href={site.github} target="_blank" rel="noopener"><span>GitHub</span><span>{curto(site.github)}</span><span>abrir</span></a>
    </div>
  </div>
  <script is:inline>
    (function () {
      var b = document.getElementById('copy'), l = document.getElementById('copy-l');
      b.addEventListener('click', function () {
        var ok = function () { l.textContent = 'copiado'; setTimeout(function () { l.textContent = 'copiar'; }, 2200); };
        if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.email).then(ok, function () { location.href = 'mailto:' + b.dataset.email; });
        else location.href = 'mailto:' + b.dataset.email;
      });
    })();
  </script>
</Base>
